



CUSTOM_SW {
  operands: {
      unsigned<5> rs1;
      unsigned<5> rs2;
      signed<12> imm;
  }
  encoding: imm[11:5] :: rs2[4:0] :: rs1[4:0] :: 3'b010 :: imm[4:0] :: 7'b0100011;
  assembly:"{name(rs2)}, {imm}({name(rs1)})";
  behavior: {
      unsigned<XLEN> store_address = X[rs1] + (signed)imm;
      MEM32[store_address] = (signed<32>)X[rs2];
  }
}
